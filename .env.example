# ─── Banco de dados PostgreSQL ───────────────────────────────────────────────
# Em produção, use credenciais fortes e conexão SSL:
# DATABASE_URL="postgresql://usuario:senha_segura@host:5432/action_fitness?schema=public&sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/action_fitness?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# OBRIGATÓRIO: Gere segredos fortes com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="TROQUE-POR-STRING-ALEATORIA-LONGA-MINIMO-32-CHARS"
JWT_REFRESH_SECRET="TROQUE-POR-OUTRA-STRING-ALEATORIA-LONGA-MINIMO-32-CHARS"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Em produção: NODE_ENV=production
# Fuso usado nas regras de agendamento
APP_TIME_ZONE="America/Sao_Paulo"

# ─── Admin Inicial (seed) ────────────────────────────────────────────────────
# Troque a senha padrão em produção!
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@actionfitness.com.br"
ADMIN_PASSWORD="Admin@2026!"

# ─── SMTP (opcional) ─────────────────────────────────────────────────────────
# Deixe SMTP_HOST vazio para desativar envio de e-mails
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Action Fitness <noreply@actionfitness.com.br>"

# ─── URL da Aplicação ────────────────────────────────────────────────────────
# Em produção: APP_URL="https://seudominio.com.br"
# Usado para CORS origin e links em e-mails
APP_URL="http://localhost:3000"
